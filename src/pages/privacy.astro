---
import Layout from "../layouts/Layout.astro";
import LegalContent from "@src/components/LegalContent.astro";
import { getPage } from "@tiebreak/api/wp/pages";
import { getLang, decodeAmpEntities } from "@tiebreak/api/utility/util";

// WordPress page (SITE_SLUG in .env): the privacy policy is its "privacy_policy" group.
const page = await getPage(import.meta.env.SITE_SLUG, Astro);
const wp = decodeAmpEntities(page?.acf ?? {});
const lang = getLang(Astro);
---

<Layout
  title="Privacy Policy — LoyalEdge"
  description="How Peak CS Limited collects, uses and protects personal data on the LoyalEdge website."
>
  <LegalContent legal={wp.privacy_policy} lang={lang} />
</Layout>
