---
import Layout from "../layouts/Layout.astro";
import LegalContent from "@src/components/LegalContent.astro";
import { getPage } from "@tiebreak/api/wp/pages";
import { getLang, decodeAmpEntities } from "@tiebreak/api/utility/util";

// WordPress page (SITE_SLUG in .env): the terms are its "terms_and_conditions" group.
const page = await getPage(import.meta.env.SITE_SLUG, Astro);
const wp = decodeAmpEntities(page?.acf ?? {});
const lang = getLang(Astro);
---

<Layout
  title="Terms & Conditions — LoyalEdge"
  description="The Terms and Conditions governing access to and use of the LoyalEdge website."
>
  <LegalContent legal={wp.terms_and_conditions} lang={lang} />
</Layout>
