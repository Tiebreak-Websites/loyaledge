---
import Layout from "../layouts/Layout.astro";
import Hero from "@src/components/home/Hero.astro";
import StatBand from "@src/components/home/StatBand.astro";
import WhyLoyalEdge from "@src/components/home/WhyLoyalEdge.astro";
import TargetAudience from "@src/components/home/TargetAudience.astro";
import LifeInMalta from "@src/components/home/LifeInMalta.astro";
import Benefits from "@src/components/home/Benefits.astro";
import Growth from "@src/components/home/Growth.astro";
import About from "@src/components/home/About.astro";
import OpenRoles from "@src/components/home/OpenRoles.astro";
import Apply from "@src/components/home/Apply.astro";
import { getPage } from "@tiebreak/api/wp/pages";
import { getLang, decodeAmpEntities } from "@tiebreak/api/utility/util";

// WordPress page (SITE_SLUG in .env): one ACF group per section, passed to each section as a prop.
const page = await getPage(import.meta.env.SITE_SLUG, Astro);
// WordPress escapes "&" in text fields ("Travel &amp; relocation"); decode it once here.
const wp = decodeAmpEntities(page?.acf ?? {});
const lang = getLang(Astro);
---

<Layout
  home
  title="LoyalEdge Careers — Customer Support Roles in Malta"
  description="Join LoyalEdge in Malta as a Customer Support Representative. Support an established book of clients, with rewards tied to the value you protect, full relocation support and paid training."
  ogDescription="Build client relationships that last, in the Mediterranean sun. Paid training, performance rewards, full relocation support."
  twitterDescription="Build client relationships that last, in the Mediterranean sun."
>
  <Fragment slot="head">
    <!-- SweetAlert2: success popup after the application is sent (src/lib/forms.js) -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.all.min.js" defer></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org/",
        "@type": "JobPosting",
        "title": "Customer Support Representative (Multilingual)",
        "description": "Support an established book of clients as the lead point of contact for their day-to-day needs. Respond to client requests, keep operations running smoothly, and maintain high standards of client care and communication.",
        "employmentType": "FULL_TIME",
        "hiringOrganization": {
          "@type": "Organization",
          "name": "LoyalEdge",
          "description": "International outsourcing company specialising in Customer Support and client relations."
        },
        "jobLocation": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "MT",
            "addressLocality": "Malta"
          }
        },
        "skills": "Customer support, client relationship management, communication, multilingual",
        "jobBenefits": "Fixed base salary, monthly commission structure, relocation package with flight assistance and accommodation support, paid onboarding and training, weekly food allowance after three months, employee discounts, incentive programs."
      }
    </script>
  </Fragment>
  <main id="main">
    <!-- ============ HERO (WordPress: hero) ============ -->
    <Hero hero={wp.hero} lang={lang} />

    <!-- ============ STAT BAND (WordPress: stat_band) ============ -->
    <StatBand stat_band={wp.stat_band} lang={lang} />

    <!-- ============ WHY LOYALEDGE (WordPress: why_loyaledge) ============ -->
    <WhyLoyalEdge why_loyaledge={wp.why_loyaledge} lang={lang} />

    <!-- ============ WHO WE'RE LOOKING FOR (WordPress: target_audience) ============ -->
    <TargetAudience target_audience={wp.target_audience} lang={lang} />

    <!-- ============ MALTA (WordPress: life_in_malta) ============ -->
    <LifeInMalta life_in_malta={wp.life_in_malta} lang={lang} />

    <!-- ============ OPEN ROLES (WordPress: open_roles) ============ -->
    <OpenRoles open_roles={wp.open_roles} lang={lang} />

    <!-- ============ BENEFITS (WordPress: benefits) ============ -->
    <Benefits benefits={wp.benefits} lang={lang} />

    <!-- ============ GROWTH (WordPress: growth) ============ -->
    <Growth growth={wp.growth} lang={lang} />

    <!-- ============ ABOUT (WordPress: about) ============ -->
    <About about={wp.about} lang={lang} />

    <!-- ============ APPLY (text: src/data/i18n.json) ============ -->
    <Apply roles={wp.open_roles?.roles} recipient={wp.application_form_recipient} lang={lang} />
  </main>
</Layout>
