---
/**
 * Benefits — WordPress ACF group "benefits", passed in from index.astro.
 *
 * "benefits": {
 *   "title": "What comes with the job",
 *   "items": [{ "benefit_icon": { "url": "https://…/salary.png", "width": 84, "height": 84 }, "text": "Fixed base salary" }],
 *   "note": "Benefits and incentives may vary by role …"   // legal qualifier — keep it
 * }
 *
 * Icons: the WordPress "benefit_icon" upload when there is one (PNG/JPG/WebP are
 * downloaded and converted to WebP at build time). While "benefit_icon" is false,
 * the project's own icon for that position (FALLBACK_ICONS below) is used.
 * Uploaded icons should be one colour on a transparent background: they turn
 * white on hover through a CSS filter (global.css, `.perk-icon img`).
 */
import { getImage } from "astro:assets";

interface Props {
  benefits?: any;
  lang?: string;
}

const { benefits } = Astro.props;

// The site's current line icons, in the order of the benefits list.
const FALLBACK_ICONS = [
  // Fixed base salary
  '<rect x="2.5" y="6" width="19" height="12" rx="2"></rect><circle cx="12" cy="12" r="2.6"></circle><path d="M6.2 12h.01M17.8 12h.01"></path>',
  // Monthly commission
  '<path d="M3 17l5.5-5.5 4 4L21 7"></path><path d="M15.5 7H21v5.5"></path>',
  // Relocation package
  '<path d="M21 3L10.5 13.5"></path><path d="M21 3l-6.8 18-3.7-7.5L3 9.8z"></path>',
  // Onboarding and training
  '<path d="M12 4L2 9l10 5 10-5-10-5z"></path><path d="M6 11.5V16c0 1.5 2.7 2.8 6 2.8s6-1.3 6-2.8v-4.5"></path>',
  // Education and development
  '<path d="M4 5.5A2.5 2.5 0 016.5 3H20v15.5H6.5A2.5 2.5 0 004 21V5.5z"></path><path d="M4 18.5A2.5 2.5 0 016.5 16H20"></path>',
  // Food allowance
  '<path d="M7 3v18"></path><path d="M4 3v3.5a3 3 0 006 0V3"></path><path d="M17 3c-1.8 1.2-2.8 3.2-2.8 5.2 0 2.3 1.2 3.8 2.8 3.8V21"></path>',
  // Employee discounts
  '<path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0L3 13V3h10l7.6 7.6a2 2 0 010 2.8z"></path><path d="M7.5 7.5h.01"></path>',
  // Incentive programs
  '<path d="M8 21h8M12 17v4"></path><path d="M7 4h10v5a5 5 0 01-10 0V4z"></path><path d="M7 6H4v1a3 3 0 003 3M17 6h3v1a3 3 0 01-3 3"></path>',
  // Modern office
  '<path d="M4 21V5a2 2 0 012-2h8a2 2 0 012 2v16"></path><path d="M16 9h2a2 2 0 012 2v10"></path><path d="M3 21h18"></path><path d="M8 7h2M8 11h2M8 15h2"></path>',
  // Career progression
  '<path d="M3 20h4.5v-4.5H12V11h4.5V6.5H21"></path><path d="M17 6.5h4v4"></path>',
];

const items = await Promise.all(
  (benefits?.items || []).map(async (item: any, i: number) => {
    const upload = item?.benefit_icon;
    let iconSrc: string | null = null;
    if (upload?.url) {
      iconSrc = /\.svg$/i.test(upload.url)
        ? upload.url
        : (await getImage({ src: upload.url, width: 84, height: 84, format: "webp" })).src;
    }
    return { text: item?.text, iconSrc, fallback: FALLBACK_ICONS[i] };
  }),
);
---

<section class="section section-panel" id="benefits">
  <div class="wrap">
    <header class="section-head reveal">
      {benefits?.title && <h2>{benefits.title}</h2>}
    </header>

    <ul class="perks">
      {items.map((item) => (
        <li class="perk reveal">
          <span class="perk-icon" aria-hidden="true">
            {item.iconSrc ? (
              <img src={item.iconSrc} width="21" height="21" alt="" loading="lazy" />
            ) : item.fallback ? (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={item.fallback}
              />
            ) : null}
          </span>
          {item.text}
        </li>
      ))}
    </ul>

    {benefits?.note && <p class="perks-note reveal">{benefits.note}</p>}
  </div>
</section>
