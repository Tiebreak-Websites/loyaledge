---
/**
 * Open roles — WordPress ACF group "open_roles", passed in from index.astro.
 *
 * "open_roles": {
 *   "title": "Roles we're hiring for right now",
 *   "description": "Every role below is based on site in Malta …",
 *   "roles": [{
 *     "title": "Customer Support Representative",
 *     "title_suffix": "— Multilingual",
 *     "form_label": "Customer Support Representative – (relevant language speaker)",  // option in the form
 *     "tags": [{ "label": "Multilingual", "highlight": true }],
 *     "overview": "Create long-term, trusting relationships …",
 *     "facts": [{ "image": false, "text": "Fixed base salary + monthly commission" }],
 *     "duties_title": "What you'll do",
 *     "duties": [{ "text": "…" }],
 *     "requirements_title": "What you'll bring",
 *     "requirements": [{ "text": "…" }],
 *     "button_label": "Apply for this role",
 *     "reply_text": "We read every application and reply either way."
 *   }],
 *   "note": "Specific language requirements are listed on each open position. …"
 * }
 *
 * Roles are linked to the form's "Role" dropdown by their position in the list:
 * "Apply for this role" on role 1 pre-selects option 1 (data-apply / data-role, site.js).
 *
 * Fact icons: the fact's "image" upload when there is one, else the project's icon for
 * that position (FALLBACK_ICONS). Roles open and close with site.js (.role-toggle).
 */
import { getImage } from "astro:assets";

interface Props {
  open_roles?: any;
  lang?: string;
}

const { open_roles } = Astro.props;

// The site's current fact icons, in order: salary, training, relocation.
const FALLBACK_ICONS = [
  '<rect x="2.5" y="6" width="19" height="12" rx="2"></rect><circle cx="12" cy="12" r="2.6"></circle><path d="M6.2 12h.01M17.8 12h.01"></path>',
  '<path d="M12 4L2 9l10 5 10-5-10-5z"></path><path d="M6 11.5V16c0 1.5 2.7 2.8 6 2.8s6-1.3 6-2.8v-4.5"></path>',
  '<path d="M21 3L10.5 13.5"></path><path d="M21 3l-6.8 18-3.7-7.5L3 9.8z"></path>',
];

const roles = await Promise.all(
  (open_roles?.roles || []).map(async (role: any) => ({
    ...role,
    facts: await Promise.all(
      (role?.facts || []).map(async (fact: any, i: number) => {
        const upload = fact?.image;
        let iconSrc: string | null = null;
        if (upload?.url) {
          iconSrc = /\.svg$/i.test(upload.url)
            ? upload.url
            : (await getImage({ src: upload.url, width: 80, height: 80, format: "webp" })).src;
        }
        return { text: fact?.text, iconSrc, fallback: FALLBACK_ICONS[i] };
      }),
    ),
  })),
);
---

<section class="section" id="roles">
  <div class="wrap">
    <header class="section-head reveal">
      {open_roles?.title && <h2>{open_roles.title}</h2>}
      {open_roles?.description && <p class="section-sub">{open_roles.description}</p>}
    </header>

    <div class="roles">
      {roles.map((role: any, i: number) => (
        <article class="role reveal">
          <h3 class="role-head">
            <button type="button" class="role-toggle" aria-expanded="false" aria-controls={`role-${i + 1}`}>
              <span class="role-title">
                {role.title} {role.title_suffix && <em>{role.title_suffix}</em>}
                {role.tags?.length > 0 && (
                  <span class="role-tags">
                    {role.tags.map((tag: any) => (
                      <span class={tag.highlight ? "tag tag-accent" : "tag"}>{tag.label}</span>
                    ))}
                  </span>
                )}
              </span>
              <span class="role-chev" aria-hidden="true"></span>
            </button>
          </h3>

          <div class="role-body" id={`role-${i + 1}`} hidden>
            <div class="role-body-inner">
              {role.overview && <p class="role-overview">{role.overview}</p>}

              {role.facts.length > 0 && (
                <ul class="role-facts">
                  {role.facts.map((fact: any) => (
                    <li class="fact">
                      {fact.iconSrc ? (
                        <img src={fact.iconSrc} width="20" height="20" alt="" aria-hidden="true" loading="lazy" />
                      ) : fact.fallback ? (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          set:html={fact.fallback}
                        />
                      ) : null}
                      {fact.text}
                    </li>
                  ))}
                </ul>
              )}

              <div class="role-cols">
                <div>
                  {role.duties_title && <h4>{role.duties_title}</h4>}
                  <ul class="ticks">
                    {(role.duties || []).map((d: any) => <li>{d.text}</li>)}
                  </ul>
                </div>
                <div>
                  {role.requirements_title && <h4>{role.requirements_title}</h4>}
                  <ul class="ticks">
                    {(role.requirements || []).map((r: any) => <li>{r.text}</li>)}
                  </ul>
                </div>
              </div>

              <div class="role-cta">
                {role.button_label && (
                  <a class="btn btn-primary role-apply" href="#apply" data-apply={i + 1}>
                    {role.button_label}<span class="btn-arr" aria-hidden="true">&rarr;</span>
                  </a>
                )}
                {role.reply_text && <p class="role-reply">{role.reply_text}</p>}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    {open_roles?.note && <p class="roles-note reveal">{open_roles.note}</p>}
  </div>
</section>
