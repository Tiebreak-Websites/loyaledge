---
/**
 * "Who we're looking for" — WordPress ACF group "target_audience", passed in from index.astro.
 *
 * "target_audience": {
 *   "title": "Designed for ambitious customer-support professionals",
 *   "image": { "url": "https://…/office-conversation.jpg", "width": 1600, "height": 1200, "alt": "" },  // or false
 *   "image_alt": "Two colleagues in a relaxed one-to-one conversation …",                         // optional
 *   "items": [{ "title": "The customer-support specialist", "text": "Proven experience in …" }]
 * }
 *
 * Image: the WordPress upload, converted to WebP at build time. Until one is uploaded
 * ("image": false) the local src/assets/office-conversation.webp is used.
 * Alt: image_alt, else the image's Media Library alt text, else the default below.
 */
import { getImage } from "astro:assets";
import fallbackImage from "@src/assets/office-conversation.webp";

const FALLBACK_ALT = "Two colleagues in a relaxed one-to-one conversation at a desk in a bright, modern office";

interface Props {
  target_audience?: any;
  lang?: string;
}

const { target_audience } = Astro.props;
const items: { title?: string; text?: string }[] = target_audience?.items || [];

const source = target_audience?.image;
const image = source?.url
  ? {
      src: (await getImage({ src: source.url, width: source.width, height: source.height, format: "webp" })).src,
      width: source.width,
      height: source.height,
      alt: target_audience?.image_alt || source.alt || FALLBACK_ALT,
    }
  : {
      src: fallbackImage.src,
      width: fallbackImage.width,
      height: fallbackImage.height,
      alt: target_audience?.image_alt || FALLBACK_ALT,
    };
---

<section class="section" id="candidates">
  <div class="wrap cand-grid">
    <figure class="cand-media media-reveal reveal">
      <img src={image.src} width={image.width} height={image.height} alt={image.alt} loading="lazy" />
    </figure>

    <div>
      <header class="section-head reveal">
        {target_audience?.title && <h2>{target_audience.title}</h2>}
      </header>

      <div class="profiles">
        {items.map((item) => (
          <article class="profile reveal">
            {item.title && <h3>{item.title}</h3>}
            {item.text && <p>{item.text}</p>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
