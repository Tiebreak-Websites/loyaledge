---
/**
 * Careers application form (with CV upload). Submits through formsub to the
 * career-form endpoint (PUBLIC_CAREER_FORM_URL in .env, tiebreak v2), wired in
 * src/lib/forms.js — same setup as smartconnect-careers.
 *
 * <CareersForm roles={wp.open_roles.roles} lang={lang} />
 *
 * Text: src/data/i18n.json (form_* keys). Recipient: WordPress "application_form_recipient" (recipient prop).
 * Role options: open_roles.roles from WordPress (form_label, else title), plus form_other_role_option.
 * Each option's value is its visible text, so the email shows the role name.
 * site.js pre-selects the role when an "Apply for this role" button is clicked:
 * the button's data-apply (role number) matches the option's data-role.
 */
import { i18n } from "@tiebreak/api/utility/util";

interface Props {
  roles?: { title?: string; form_label?: string }[];
  recipient?: string;
  id?: string;
  lang?: string;
}

const { roles = [], recipient, id = "applyForm", lang = "en" } = Astro.props;
const t = (key: string) => i18n(key, lang);
const website = new URL(Astro.site ?? "https://loyaledge.net").hostname;
---

<form
  class="form reveal"
  id={id}
  method="POST"
  enctype="multipart/form-data"
  data-career-form
  data-success-message={t("form_success_message")}
  data-error-message={t("form_error_message")}
  data-success-button={t("form_success_button")}
>
  <input type="hidden" name="to" value={recipient} />
  <input type="hidden" name="website" value={website} />

  <div class="field">
    <label for="name">{t("form_name_label")} <span class="req" aria-hidden="true">*</span></label>
    <input id="name" name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for="email">{t("form_email_label")} <span class="req" aria-hidden="true">*</span></label>
    <input id="email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="phone">{t("form_phone_label")} <span class="req" aria-hidden="true">*</span></label>
    <input id="phone" name="phone" type="tel" autocomplete="tel" required />
  </div>

  <div class="field">
    <label for="languages">{t("form_languages_label")} <span class="req" aria-hidden="true">*</span></label>
    <input id="languages" name="language" type="text" placeholder={t("form_languages_placeholder")} required />
  </div>

  <div class="field">
    <label for="location">{t("form_location_label")} <span class="req" aria-hidden="true">*</span></label>
    <input id="location" name="location" type="text" placeholder={t("form_location_placeholder")} autocomplete="country-name" required />
  </div>

  <div class="field">
    <label for="role">{t("form_role_label")} <span class="req" aria-hidden="true">*</span></label>
    <select id="role" name="position" required>
      {roles.map((role, i) => {
        const label = role.form_label || role.title;
        return <option value={label} data-role={i + 1}>{label}</option>;
      })}
      <option value={t("form_other_role_option")}>{t("form_other_role_option")}</option>
    </select>
  </div>

  <div class="field field-wide">
    <label for="linkedin">{t("form_linkedin_label")} <span class="opt">{t("form_linkedin_hint")}</span></label>
    <input id="linkedin" name="link" type="url" placeholder={t("form_linkedin_placeholder")} />
  </div>

  <div class="field field-wide">
    <label for="cv">{t("form_cv_label")} <span class="opt">{t("form_cv_hint")}</span></label>
    <input id="cv" name="cv" type="file" accept=".pdf,.doc,.docx" />
  </div>

  <div class="field field-wide">
    <label for="why">{t("form_message_label")} <span class="opt">{t("form_message_hint")}</span></label>
    <textarea id="why" name="message" rows="4" placeholder={t("form_message_placeholder")}></textarea>
  </div>

  <div class="field field-wide consent">
    <label class="check">
      <input id="consent" name="consent" type="checkbox" value="1" required />
      <span>
        <Fragment set:html={t("form_consent_text")} />
        <span class="req" aria-hidden="true">*</span>
      </span>
    </label>
  </div>

  <div class="field-wide form-actions">
    <button class="btn btn-primary btn-lg" type="submit" id={`${id}-submit`}>{t("form_submit_label")}</button>
    <p id={`${id}-loading`} class="form-sending hidden">{t("form_sending_text")}</p>
    <p class="form-note">{t("form_note")}</p>
  </div>

  <p class="form-status" data-form-note role="status" aria-live="polite"></p>
</form>

<script>
  import { initCareerForms } from "@src/lib/forms";
  initCareerForms();
</script>
