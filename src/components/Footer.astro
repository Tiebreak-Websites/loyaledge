---
/**
 * Site footer — WordPress ACF group "footer", passed in from Layout.astro.
 *
 * "footer": {
 *   "tagline": "Client relationships, built to last.",
 *   "menu": [{ "link": { "title": "Why LoyalEdge", "url": "/#why", "target": "" } }],
 *   "company_text": "<p><strong>LoyalEdge</strong> — …</p>\n<p class=\"footer-contact\">Questions? <a href=\"mailto:…\">…</a></p>",  // WYSIWYG
 *   "disclaimer": "<p><strong>Disclaimer:</strong> Information on this website is provided …</p>",            // WYSIWYG
 *   "copyright": "© {year} LoyalEdge. All rights reserved.",   // {year} = current year, filled in at build
 *   "legal_links": [{ "link": { "title": "Terms & Conditions", "url": "/terms", "target": "" } }]
 * }
 *
 * Logo: the ACF image "logo_light" (white logo for the navy footer), passed in as `logo`
 * and converted to WebP at build. While it is empty, the inline SVG logo is used.
 *
 * Empty menu rows ({ "link": "" }) are skipped. Layout <div>s pasted into the
 * disclaimer editor are removed — the footer already wraps it in its own block.
 */
interface Link {
  title: string;
  url: string;
  target?: string;
}

import { getImage } from "astro:assets";

interface Props {
  footer?: any;
  logo?: { url?: string; width?: number; height?: number; alt?: string } | false;
  lang?: string;
}

const { footer, logo } = Astro.props;

// Logo shown at 164 × 50 (CSS .logo-svg--footer). PNG (lossless, crisp edges) in 1×, 2×
// and 3× so phones/tablets with 3× screens get a sharp logo too.
const logoImg = logo && logo.url
  ? await getImage({
      src: logo.url,
      width: 164,
      height: Math.round(164 * (logo.height || 632) / (logo.width || 2090)),
      densities: [1, 2, 3],
      format: "png",
    })
  : null;
const logoAlt = (logo && logo.alt) || "LoyalEdge";

const links = (rows: any): Link[] =>
  (Array.isArray(rows) ? rows : rows?.items || []).map((row: any) => row?.link).filter((link: any) => link?.url);
const menu = links(footer?.menu);
const legalLinks = links(footer?.legal_links);

// "{year}" in the copyright becomes the current year: "© {year} LoyalEdge." → "© 2026 LoyalEdge."
const copyright = String(footer?.copyright || "").replace(/\{year\}/gi, String(new Date().getFullYear()));

// Keep only the disclaimer's text: drop any wrapper <div>s and empty ones.
const disclaimer = String(footer?.disclaimer || "")
  .replace(/<\/?div[^>]*>/gi, "")
  .trim();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      {logoImg ? (
        <img class="logo-svg logo-svg--footer logo-img" src={logoImg.src} srcset={logoImg.srcSet.attribute} width="164" height="50" alt={logoAlt} loading="lazy" />
      ) : (
        <svg class="logo-svg logo-svg--footer" role="img" aria-label="LoyalEdge"><use href="#loyaledge"></use></svg>
      )}
      {footer?.tagline && <p>{footer.tagline}</p>}
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {menu.map((link) => (
        <a href={link.url} target={link.target || undefined}>{link.title}</a>
      ))}
    </nav>

    {footer?.company_text && <div class="footer-legal" set:html={footer.company_text} />}
  </div>
  {disclaimer && <div class="wrap footer-disclaimer" set:html={disclaimer} />}
  <div class="wrap footer-bottom">
    {copyright && <p>{copyright}</p>}
    <p>
      {legalLinks.map((link, i) => (
        <Fragment>{i > 0 && " · "}<a href={link.url} target={link.target || undefined}>{link.title}</a></Fragment>
      ))}
    </p>
  </div>
</footer>
